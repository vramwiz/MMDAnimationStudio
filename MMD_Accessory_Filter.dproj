        <PostBuildEvent><![CDATA[copy /Y "C:\ProgramData\aviutl2\Plugin\MMD\$(PROJECTNAME).dll" "C:\ProgramData\aviutl2\Plugin\MMD\$(PROJECTNAME).auf2"&&if exist "C:\ProgramData\aviutl2\Plugin\MMD\$(PROJECTNAME).dll" del /Q "C:\ProgramData\aviutl2\Plugin\MMD\$(PROJECTNAME).dll"&&if exist "C:\ProgramData\aviutl2\Plugin\MMD\$(PROJECTNAME).rsm" del /Q "C:\ProgramData\aviutl2\Plugin\MMD\$(PROJECTNAME).rsm"]]></PostBuildEvent>
