        <AppDPIAwarenessMode>none</AppDPIAwarenessMode>
        <DCC_ExeOutput>C:\ProgramData\aviutl2\Plugin\MMD</DCC_ExeOutput>
        <PreBuildEvent><![CDATA[if not exist "C:\ProgramData\aviutl2\Plugin\MMD" mkdir "C:\ProgramData\aviutl2\Plugin\MMD"]]></PreBuildEvent>
        <PreBuildEventIgnoreExitCode>False</PreBuildEventIgnoreExitCode>
        <PostBuildEvent><![CDATA[copy /Y "C:\ProgramData\aviutl2\Plugin\MMD\$(PROJECTNAME).dll" "C:\ProgramData\aviutl2\Plugin\MMD\$(PROJECTNAME).auf2"]]></PostBuildEvent>
