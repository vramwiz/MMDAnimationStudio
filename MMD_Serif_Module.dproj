<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
    <PropertyGroup>
        <ProjectGuid>{4FC695A2-A37B-4DA5-8C79-445D4ED32042}</ProjectGuid>
        <ProjectVersion>20.4</ProjectVersion>
        <FrameworkType>None</FrameworkType>
        <Config Condition="'$(Config)'==''">Debug</Config>
        <Platform Condition="'$(Platform)'==''">Win64</Platform>
        <ProjectName Condition="'$(ProjectName)'==''">MMD_Serif_Module</ProjectName>
        <TargetedPlatforms>2</TargetedPlatforms>
        <AppType>Library</AppType>
        <MainSource>MMD_Serif_Module.dpr</MainSource>
        <Base>True</Base>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Config)'=='Base' or '$(Base)'!=''">
        <Base>true</Base>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Config)'=='Debug' or '$(Cfg_1)'!=''">
        <Cfg_1>true</Cfg_1>
        <CfgParent>Base</CfgParent>
        <Base>true</Base>
    </PropertyGroup>
    <PropertyGroup Condition="('$(Platform)'=='Win64' and '$(Cfg_1)'=='true') or '$(Cfg_1_Win64)'!=''">
        <Cfg_1_Win64>true</Cfg_1_Win64>
        <CfgParent>Cfg_1</CfgParent>
        <Cfg_1>true</Cfg_1>
        <Base>true</Base>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Config)'=='Release' or '$(Cfg_2)'!=''">
        <Cfg_2>true</Cfg_2>
        <CfgParent>Base</CfgParent>
        <Base>true</Base>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Base)'!=''">
        <GenDll>true</GenDll>
        <SanitizedProjectName>MMD_Serif_Module</SanitizedProjectName>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Cfg_1_Win64)'!=''">
        <Debugger_HostApplication>D:\aviutl2_v2.1.3a\aviutl2.exe</Debugger_HostApplication>
    </PropertyGroup>
    <ItemGroup>
        <DelphiCompile Include="$(MainSource)">
            <MainSource>MainSource</MainSource>
        </DelphiCompile>
        <DCCReference Include="Source\Plugin\Serif\Module\MmdSerifModuleTypes.pas"/>
        <DCCReference Include="Source\Plugin\Serif\Module\MmdSerifModuleAdapter.pas"/>
        <DCCReference Include="Source\Plugin\Serif\Module\MMD_Serif_ModulePlugin.pas"/>
        <DCCReference Include="..\AviUtl2PluginLib\Serif\Plugin\Module\SerifModulePublisher.pas"/>
        <DCCReference Include="..\AviUtl2PluginLib\Lib\SharedMemory\SharedMemoryBase.pas"/>
        <DCCReference Include="..\AviUtl2PluginLib\Lib\KeyValue\KeyValueText.pas"/>
        <DCCReference Include="..\AviUtl2PluginLib\Lib\SharedMemory\SerifTalkSharedCodec.pas"/>
        <DCCReference Include="..\AviUtl2PluginLib\Serif\Plugin\Module\SerifSpeechSync.pas"/>
        <DCCReference Include="..\AviUtl2PluginLib\Lib\SharedMemory\SerifSharedIndex.pas"/>
        <DCCReference Include="..\AviUtl2PluginLib\Lib\SharedMemory\SerifTalkSharedIndexPublisher.pas"/>
        <DCCReference Include="..\AviUtl2PluginLib\Lib\SharedMemory\SerifTalkSharedMemory.pas"/>
        <BuildConfiguration Include="Base">
            <Key>Base</Key>
        </BuildConfiguration>
        <BuildConfiguration Include="Debug">
            <Key>Cfg_1</Key>
            <CfgParent>Base</CfgParent>
        </BuildConfiguration>
        <BuildConfiguration Include="Release">
            <Key>Cfg_2</Key>
            <CfgParent>Base</CfgParent>
        </BuildConfiguration>
    </ItemGroup>
    <ProjectExtensions>
        <Borland.Personality>Delphi.Personality.12</Borland.Personality>
        <BorlandProject>
            <Delphi.Personality>
                <Source>
                    <Source Name="MainSource">MMD_Serif_Module.dpr</Source>
                </Source>
                <Platforms>
                    <Platform value="Win32">False</Platform>
                    <Platform value="Win64">True</Platform>
                </Platforms>
            </Delphi.Personality>
            <Platforms>
                <Platform value="Win32">False</Platform>
                <Platform value="Win64">True</Platform>
            </Platforms>
        </BorlandProject>
        <ProjectFileVersion>12</ProjectFileVersion>
    </ProjectExtensions>
    <Import Project="$(BDS)\Bin\CodeGear.Delphi.Targets" Condition="Exists('$(BDS)\Bin\CodeGear.Delphi.Targets')"/>
    <Import Project="$(APPDATA)\Embarcadero\$(BDSAPPDATABASEDIR)\$(PRODUCTVERSION)\UserTools.proj" Condition="Exists('$(APPDATA)\Embarcadero\$(BDSAPPDATABASEDIR)\$(PRODUCTVERSION)\UserTools.proj')"/>
</Project>
