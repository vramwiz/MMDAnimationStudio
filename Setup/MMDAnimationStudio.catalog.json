[
  {
    "id": "VRAMWIZ.MMDAnimationStudio",
    "name": "MMDアニメーションスタジオ",
    "type": "汎用プラグイン",
    "summary": "MMDモデルの表示・ポーズ・表情・セリフ連携を統合する動画制作プラグイン",
    "description": "https://raw.githubusercontent.com/vramwiz/MMDAnimationStudio/refs/heads/main/README.md",
    "author": "VRAMの魔術師",
    "repoURL": "https://github.com/vramwiz/MMDAnimationStudio/",
    "licenses": [
      {
        "type": "カスタムライセンス",
        "isCustom": true,
        "copyrights": [],
        "licenseBody": "本ソフトウェアは無償で使用・改変・再配布・商用利用が可能です。\n\n再配布する場合は、原作者「VRAMの魔術師」のクレジットを明記してください。\n改変版を配布する場合も同様に原作者名を表示してください。\n\n本ソフトウェアは現状のまま提供され、いかなる保証もありません。\n本ソフトウェアの使用によって生じたいかなる損害についても、\n作者は一切の責任を負いません。"
      }
    ],
    "tags": [
      "MMD",
      "3Dモデル",
      "アニメーション",
      "ポーズ",
      "表情",
      "セリフ"
    ],
    "dependencies": [],
    "images": [],
    "installer": {
      "source": {
        "type": "githubRelease",
        "owner": "vramwiz",
        "repo": "MMDAnimationStudio",
        "pattern": "^MMDAnimationStudio\\.zip$",
        "github": {
          "owner": "vramwiz",
          "repo": "MMDAnimationStudio",
          "pattern": "^MMDAnimationStudio\\.zip$"
        }
      },
      "install": [
        {
          "action": "download"
        },
        {
          "action": "extract"
        },
        {
          "action": "copy",
          "from": "{tmp}/Plugin/MMDAnimationStudio.aux2",
          "to": "{pluginsDir}/MMD"
        },
        {
          "action": "copy",
          "from": "{tmp}/Plugin/MMD_Model_Filter.auf2",
          "to": "{pluginsDir}/MMD"
        },
        {
          "action": "copy",
          "from": "{tmp}/Plugin/MMD_Accessory_Filter.auf2",
          "to": "{pluginsDir}/MMD"
        },
        {
          "action": "delete",
          "path": "{pluginsDir}/MMD/MMD_Pose_Filter.auf2"
        },
        {
          "action": "delete",
          "path": "{pluginsDir}/MMD/MMD_Motion_Filter.auf2"
        },
        {
          "action": "copy",
          "from": "{tmp}/Plugin/MMD_Face_Filter.auf2",
          "to": "{pluginsDir}/MMD"
        },
        {
          "action": "copy",
          "from": "{tmp}/Plugin/MMD_Serif_Draw_Filter.auf2",
          "to": "{pluginsDir}/MMD"
        },
        {
          "action": "copy",
          "from": "{tmp}/Plugin/sk4d.dll",
          "to": "{pluginsDir}/MMD"
        },
        {
          "action": "copy",
          "from": "{tmp}/README.md",
          "to": "{pluginsDir}/MMD"
        },
        {
          "action": "copy",
          "from": "{tmp}/Script/@MMD_Script.obj2",
          "to": "{scriptsDir}/MMD"
        },
        {
          "action": "copy",
          "from": "{tmp}/Script/MMD_Module.mod2",
          "to": "{scriptsDir}/MMD"
        }
      ],
      "uninstall": [
        {
          "action": "delete",
          "path": "{pluginsDir}/MMD/MMDAnimationStudio.aux2"
        },
        {
          "action": "delete",
          "path": "{pluginsDir}/MMD/MMD_Model_Filter.auf2"
        },
        {
          "action": "delete",
          "path": "{pluginsDir}/MMD/MMD_Accessory_Filter.auf2"
        },
        {
          "action": "delete",
          "path": "{pluginsDir}/MMD/MMD_Pose_Filter.auf2"
        },
        {
          "action": "delete",
          "path": "{pluginsDir}/MMD/MMD_Motion_Filter.auf2"
        },
        {
          "action": "delete",
          "path": "{pluginsDir}/MMD/MMD_Face_Filter.auf2"
        },
        {
          "action": "delete",
          "path": "{pluginsDir}/MMD/MMD_Serif_Draw_Filter.auf2"
        },
        {
          "action": "delete",
          "path": "{pluginsDir}/MMD/sk4d.dll"
        },
        {
          "action": "delete",
          "path": "{pluginsDir}/MMD/README.md"
        },
        {
          "action": "delete",
          "path": "{scriptsDir}/MMD/@MMD_Script.obj2"
        },
        {
          "action": "delete",
          "path": "{scriptsDir}/MMD/MMD_Module.mod2"
        },
        {
          "action": "delete",
          "path": "{pluginsDir}/MMD"
        },
        {
          "action": "delete",
          "path": "{scriptsDir}/MMD"
        }
      ]
    },
    "version": [
      {
        "version": "v1.0.0",
        "release_date": "2026-08-30",
        "file": [
          {
            "path": "{pluginsDir}/MMD/MMDAnimationStudio.aux2",
            "XXH3_128": "4a76613283b7c183d9cb30d3b07b0dc2"
          }
        ]
      }
    ]
  }
]
